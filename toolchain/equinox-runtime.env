# One Agave release supplies solana, cargo-build-sbf, validator and matching
# platform-tools.
#
# 4.2.1 is the authoritative program build target. The locally verified,
# reproducible combination is:
#
#   solana-cli        4.2.1
#   cargo-build-sbf   4.1.0
#   platform-tools    v1.54
#   rustc             1.89.0 (the platform-tools toolchain, not the host rustc)
#   LiteSVM           0.16.0
#
# Do not reintroduce a second authoritative version here or in any workflow:
# the earlier 2.2.20 pin could not build this workspace at all (its bundled
# cargo 1.84 cannot parse `edition2024` dependencies), and the mismatch between
# the two pins is what obscured the real Gate 2 blocker.
AGAVE_VERSION=4.2.1
LITESVM_VERSION=0.16.0
SOLANA_SBPF_VERSION=4.2.1

# Exact expected tool versions, checked by scripts/install-equinox-toolchain.sh
# so a mixed release set fails loudly instead of silently producing a
# non-loadable artifact.
EXPECTED_CARGO_BUILD_SBF=4.1.0
EXPECTED_PLATFORM_TOOLS=v1.54
