{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stockstream",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "vars": {
    "STOCKSTREAM_RELAYER_URL": "https://stockstream-market-api.ansht.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
