# StockStream environment configuration.
#
# ONLY public defaults and empty names live here. Secrets are supplied via
# untracked environment storage (shell env, workers/.dev.vars). Any private
# value must be ROTATED if it ever appears in chat, docs, git history, or a
# browser bundle (see scripts/secret-scan.sh).

NODE_ENV=development
SOLANA_NETWORK=devnet

# Deployed StockStream program (Devnet).
STOCKSTREAM_PROGRAM_ID=H3UogXdaamHi4Ga9ZzrZNNttCRpasZgarexVyNTZvGET

# Devnet RPC. Leave SOLANA_RPC_URL empty for the public default; never
# commit an RPC URL that embeds a private API key.
SOLANA_RPC_URL=
SOLANA_WS_URL=wss://api.devnet.solana.com

# Browser-side Devnet RPC for main-wallet transaction simulate/submit/confirm
# and readback. Public default only -- an RPC URL that embeds a private API
# key must never be prefixed NEXT_PUBLIC_ (it would ship in the bundle).
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Pyth Pro (server-side only; the key NEVER enters a browser bundle).
# Rotated replacement credentials go here, not in any pasted/chat history.
PYTH_PRO_API_KEY=
PYTH_PRO_WS_0=wss://pyth-lazer-0.dourolabs.app/v1/stream
PYTH_PRO_WS_1=wss://pyth-lazer-1.dourolabs.app/v1/stream
PYTH_PRO_WS_2=wss://pyth-lazer-2.dourolabs.app/v1/stream
PYTH_PRO_ENDPOINTS=

# Privy: the public app id may enter the browser bundle; the app secret
# must remain server-side only.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# MagicBlock Devnet (verified public defaults; see docs/magicblock.md).
MAGIC_ROUTER_URL=https://devnet-router.magicblock.app
MAGIC_ROUTER_WS_URL=wss://devnet-router.magicblock.app
MAGICBLOCK_RPC_URL=https://devnet-as.magicblock.app
MAGICBLOCK_VALIDATOR=MAS1Dt9qreoRMQ14YQuhg8UTZMMzDdKhmkZMECCzk57

# Keeper signing. LOCAL_DEVNET mode: a separate Devnet keeper keypair --
# NEVER the deploy/upgrade authority at ~/.config/solana/id.json and NEVER
# a browser/session key. KEEPER_KEYPAIR_JSON holds the keypair JSON content
# (untracked); KEEPER_PUBLIC_KEY is its validation address.
KEEPER_KEYPAIR_JSON=
KEEPER_PUBLIC_KEY=

# Public frontend deployment configuration (safe to expose).
NEXT_PUBLIC_STOCKSTREAM_MARKET_ADDRESS=
NEXT_PUBLIC_STOCKSTREAM_MARKET_SYMBOL=AAPL-PERP
NEXT_PUBLIC_STOCKSTREAM_MARKET_API_URL=
NEXT_PUBLIC_STOCKSTREAM_SETTLEMENT_SCRATCH_ADDRESS=
NEXT_PUBLIC_STOCKSTREAM_COLLATERAL_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_STOCKSTREAM_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
NEXT_PUBLIC_STOCKSTREAM_VAULT=
NEXT_PUBLIC_STOCKSTREAM_VAULT_AUTHORITY=

# Session-key relayer (workers/src/index.ts POST /v1/relay/session), reached
# only through this app's own app/api/relay/session proxy -- the browser
# never holds a relayer credential. STOCKSTREAM_RELAYER_URL/_TOKEN are
# server-only. KNOWN GAP: the Worker route has no per-user auth of its own
# yet, only a shared bearer, so STOCKSTREAM_RELAYER_TOKEN must currently be
# set to the same value as the Worker's INGESTION_TOKEN -- that conflates
# keeper ingestion and user-trade relaying behind one secret and should be
# split by the backend agent. NEXT_PUBLIC_STOCKSTREAM_RELAYER_ADDRESS is the
# relayer's public fee-payer address (not a secret) that the browser must
# compile into every session-signed transaction; it is unset because
# nothing in workers/ currently assigns globalThis.__stockstreamRelayerSigner
# (POST /v1/relay/session replies 503 relayer_signer_unconfigured until it
# does) -- session-signed trading stays disabled in the UI until this is set.
STOCKSTREAM_RELAYER_URL=http://localhost:8787
STOCKSTREAM_RELAYER_TOKEN=
NEXT_PUBLIC_STOCKSTREAM_RELAYER_ADDRESS=
