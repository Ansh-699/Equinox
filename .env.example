# Browser wallet and login
NEXT_PUBLIC_PRIVY_APP_ID=

# Default: demo. Use devnet only after program IDs and credentials are configured.
NEXT_PUBLIC_STOCKSTREAM_MODE=demo
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_MAGIC_ROUTER_URL=https://devnet-router.magicblock.app
NEXT_PUBLIC_STOCKSTREAM_MARKET_API_URL=http://localhost:8787
NEXT_PUBLIC_STOCKSTREAM_MARKET_SYMBOL=AAPL-PERP

# Server-only secrets. Never expose these as NEXT_PUBLIC_* variables.
PYTH_PRO_API_KEY=
DATABASE_URL=
CLAWPUMP_API_KEY=

# Trusted server-to-server market publisher. Never expose these in browser code.
STOCKSTREAM_MARKET_API_URL=http://localhost:8787
STOCKSTREAM_INGESTION_TOKEN=
STOCKSTREAM_MARKET_SYMBOL=
STOCKSTREAM_ORACLE_FEED_ID=
