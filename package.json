{
  "name": "equinox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "next dev -p 4173",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:devnet": "RUN_DEVNET_E2E=1 playwright test --config=playwright.devnet.config.ts",
    "test:browser:production": "playwright test --config=playwright.production.config.ts",
    "check:secrets": "bash scripts/secret-scan.sh",
    "verify": "bash scripts/verify.sh",
    "generate:equinox-abi": "GENERATE_MANIFEST=1 MANIFEST_OUTPUT=$(pwd)/clients/equinox/src/abi/layout.json cargo test -p equinox --test abi_manifest -- generate_manifest",
    "check:equinox-abi": "GENERATE_MANIFEST=1 MANIFEST_OUTPUT=/tmp/abi-check.json cargo test -p equinox --test abi_manifest -- generate_manifest > /dev/null && diff /tmp/abi-check.json clients/equinox/src/abi/layout.json && echo ABI-OK",
    "check:v3-layout-fixture": "V3_LAYOUT_FIXTURE_OUTPUT=/tmp/v3-core-revision2.hex cargo test -p equinox --test v3_layout_overlay validator_overlay_preserves_all_economic_and_oracle_bytes > /dev/null && diff /tmp/v3-core-revision2.hex clients/equinox/src/abi/v3-core-revision2.hex && echo V3-LAYOUT-FIXTURE-OK",
    "probe:er-compatibility": "node scripts/er-compatibility-probe.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@magicblock-labs/ephemeral-rollups-kit": "0.17.0",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.12",
    "@privy-io/node": "^0.34.0",
    "@privy-io/react-auth": "3.42.0",
    "@pythnetwork/pyth-lazer-sdk": "7.0.0",
    "@solana-program/memo": "0.10.0",
    "@solana-program/system": "0.10.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.5.1",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@stripe/stripe-js": "^8.4.0",
    "@wallet-standard/app": "^1.1.1",
    "bn.js": "5.2.2",
    "buffer": "6.0.3",
    "ed25519-hd-key": "^2.0.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "@magicblock-labs/ephemeral-rollups-kit": {
      "@solana-program/system": "0.9.0"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.57.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bn.js": "5.2.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vinext/cloudflare": "1.0.0-beta.9",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.8.3",
    "vinext": "1.0.0-beta.11",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "ws": "^8.21.3"
  },
  "type": "module"
}
