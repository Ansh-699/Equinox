{
  "name": "stockstream",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "next dev -p 4173",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:production": "playwright test --config=playwright.production.config.ts",
    "generate:stockstream-abi": "GENERATE_MANIFEST=1 MANIFEST_OUTPUT=$(pwd)/clients/stockstream/src/abi/layout.json cargo test -p stockstream --test abi_manifest -- generate_manifest",
    "check:stockstream-abi": "GENERATE_MANIFEST=1 MANIFEST_OUTPUT=/tmp/abi-check.json cargo test -p stockstream --test abi_manifest -- generate_manifest > /dev/null && diff /tmp/abi-check.json clients/stockstream/src/abi/layout.json && echo ABI-OK"
  },
  "dependencies": {
    "@magicblock-labs/ephemeral-rollups-kit": "0.17.0",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.12",
    "@privy-io/node": "^0.34.0",
    "@privy-io/react-auth": "3.42.0",
    "@pythnetwork/pyth-lazer-sdk": "7.0.0",
    "@solana-program/memo": "0.10.0",
    "@solana-program/system": "0.10.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.5.1",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@stripe/stripe-js": "^8.4.0",
    "bn.js": "5.2.2",
    "buffer": "6.0.3",
    "ed25519-hd-key": "^2.0.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "@magicblock-labs/ephemeral-rollups-kit": {
      "@solana-program/system": "0.9.0"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/bn.js": "5.2.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.5",
    "typescript": "5.8.3",
    "vitest": "4.0.16",
    "ws": "^8.21.3"
  }
}
