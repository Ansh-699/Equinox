{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stockstream-market-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "development",
    "PYTH_PRO_FEED_ID": "922",
    "PYTH_PRO_MIN_CHANNEL": "fixed_rate@50ms"
  },
  "secrets": {
    "required": ["INGESTION_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stockstream-index",
      "database_id": "1dced396-c76a-4147-8a4f-70465e9aff55",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MARKET_STREAM",
        "class_name": "MarketStream"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MarketStream"]
    }
  ],
  "env": {
    "staging": {
      "name": "stockstream-market-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "PYTH_PRO_FEED_ID": "922",
        "PYTH_PRO_MIN_CHANNEL": "fixed_rate@50ms"
      },
      "secrets": {
        "required": ["INGESTION_TOKEN", "PRIVY_APP_ID", "PRIVY_APP_SECRET", "PYTH_PRO_API_KEY"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stockstream-index",
          "database_id": "1dced396-c76a-4147-8a4f-70465e9aff55",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "MARKET_STREAM",
            "class_name": "MarketStream"
          }
        ]
      }
    },
    "production": {
      "name": "stockstream-market-api-production",
      "vars": {
        "ENVIRONMENT": "production",
        "PYTH_PRO_FEED_ID": "922",
        "PYTH_PRO_MIN_CHANNEL": "fixed_rate@50ms"
      },
      "secrets": {
        "required": ["INGESTION_TOKEN", "PRIVY_APP_ID", "PRIVY_APP_SECRET", "PYTH_PRO_API_KEY"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stockstream-index",
          "database_id": "1dced396-c76a-4147-8a4f-70465e9aff55",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "MARKET_STREAM",
            "class_name": "MarketStream"
          }
        ]
      }
    }
  }
}
