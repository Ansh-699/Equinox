{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stockstream-market-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Every minute: refresh the TSLA Pyth snapshot (see scheduled() in src/index.ts).
  // Run beside the backends each request round-trips to several times: the
  // MagicBlock rollup (devnet-as) and the market-maker VM are in Singapore.
  "placement": { "region": "azure:southeastasia" },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "PYTH_PRO_FEED_ID": "1435",
    "PYTH_PRO_MIN_CHANNEL": "fixed_rate@50ms",
    "MAGICBLOCK_RPC_URL": "https://devnet-as.magicblock.app",
    "MM_STATUS_URL": "https://4-194-209-138.sslip.io/v1/mm/status",
    "CORS_ALLOWED_ORIGINS": "https://equinox.ansht.workers.dev,http://localhost:3000,http://127.0.0.1:3000"
  },
  // Only declared secrets are bound at runtime; every secret the Worker reads must be listed.
  "secrets": {
    "required": [
      "INGESTION_TOKEN", "SOLANA_RPC_URL", "MAGIC_ROUTER_URL", "PYTH_PRO_API_KEY",
      "PRIVY_APP_ID", "PRIVY_APP_SECRET", "RELAYER_KEYPAIR_JSON", "RELAYER_SERVICE_TOKEN",
      "KEEPER_KEYPAIR_JSON", "KEEPER_PUBLIC_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stockstream-index",
      "database_id": "1dced396-c76a-4147-8a4f-70465e9aff55",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MARKET_STREAM",
        "class_name": "MarketStream"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MarketStream"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MarketMaker"]
    },
    {
      // The market maker moved to services/market-maker (a VM): Durable Object limits.
      "tag": "v3",
      "deleted_classes": ["MarketMaker"]
    }
  ],
  "env": {
    "staging": {
      "name": "stockstream-market-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "PYTH_PRO_FEED_ID": "1435",
        "PYTH_PRO_MIN_CHANNEL": "fixed_rate@50ms"
      },
      "secrets": {
        "required": ["INGESTION_TOKEN", "PRIVY_APP_ID", "PRIVY_APP_SECRET", "PYTH_PRO_API_KEY"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stockstream-index",
          "database_id": "1dced396-c76a-4147-8a4f-70465e9aff55",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "MARKET_STREAM",
            "class_name": "MarketStream"
          }
        ]
      }
    },
    "production": {
      "name": "stockstream-market-api-production",
      "vars": {
        "ENVIRONMENT": "production",
        "PYTH_PRO_FEED_ID": "1435",
        "PYTH_PRO_MIN_CHANNEL": "fixed_rate@50ms"
      },
      "secrets": {
        "required": ["INGESTION_TOKEN", "PRIVY_APP_ID", "PRIVY_APP_SECRET", "PYTH_PRO_API_KEY"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stockstream-index",
          "database_id": "1dced396-c76a-4147-8a4f-70465e9aff55",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "MARKET_STREAM",
            "class_name": "MarketStream"
          }
        ]
      }
    }
  }
}
