INGESTION_TOKEN=replace-with-a-local-development-token
# Authenticates the Next.js app/api/relay/session proxy to this Worker's
# POST /v1/relay/session (x-equinox-relayer-service-token header) --
# a separate secret from INGESTION_TOKEN, and must match the root project's
# EQUINOX_RELAYER_TOKEN. Never a substitute for the per-user Privy
# check that same route also performs.
RELAYER_SERVICE_TOKEN=replace-with-a-local-development-token
# Pyth Pro IDs are numeric catalog IDs, not Hermes hashes. Keep these
# server-only and set them only after scripts/pyth-catalog-discovery.mjs
# returns an entitled risk feed.
PYTH_PRO_FEED_ID=
PYTH_PRO_MIN_CHANNEL=
