# /etc/stockstream/mm.env  (chmod 600, owned by root)
MM_MAKER_KEYPAIR=/etc/stockstream/mm-maker.json
MM_TAKER_KEYPAIR=/etc/stockstream/mm-taker.json
# Optional: the core's keeper key (commits, funding, liquidation).
#MM_KEEPER_KEYPAIR=/etc/stockstream/mm-keeper.json
# Behind Caddy: only localhost. Without a proxy use 0.0.0.0:8080.
MM_STATUS_ADDR=127.0.0.1:8080
# Shown in the terminal next to the bot's ping, e.g. SGP1 / southeastasia.
MM_REGION=SGP1
MARKET_API_URL=https://stockstream-market-api.ansht.workers.dev
# MAGICBLOCK_RPC_URL=https://devnet-as.magicblock.app
# MM_TICK_MS=400
# RUST_LOG=info
